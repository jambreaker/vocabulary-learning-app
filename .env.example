# Copy this file to `.env` and adjust values for your local setup.
# `.env` is git-ignored and must never be committed.

# SQLite connection string used by Prisma. The path is relative to the
# `prisma/` directory where the schema lives.
DATABASE_URL="file:./dev.db"

# Single admin account (see docs/fachkonzept.md, Abschnitt 11). No registration
# or user management - credentials are only ever configured via env vars.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie. Generate a random value with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-64-character-hex-string"
